<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nuvio RS: settings hand-over from builds made before the rename (same signing key only). -->
    <permission
        android:name="com.nuvio.reshaped.tv.permission.MIGRATE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.nuvio.reshaped.tv.permission.MIGRATE" />

    <queries>
        <package android:name="com.nuviodebug.com" />
        <package android:name="com.nuvioreshaped.tv" />
    </queries>

    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Nuvio CS: launcher name comes from fork.properties and is not translated. -->
    <application
        android:label="@string/fork_app_name"
        tools:replace="android:label">
        <activity
            android:name=".launcher.AppIconDefault"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <activity
            android:name=".launcher.AppIconArcticBlue"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <activity
            android:name=".launcher.AppIconEmerald"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <activity
            android:name=".launcher.AppIconRoseGold"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <activity
            android:name=".launcher.AppIconCopper"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <activity
            android:name=".launcher.AppIconGraphite"
            android:label="@string/fork_app_name"
            tools:replace="android:label" />
        <provider
            android:name="com.nuvio.tv.reshaped.ReshapedMigrationProvider"
            android:authorities="${applicationId}.reshaped.migration"
            android:exported="true"
            android:permission="com.nuvio.reshaped.tv.permission.MIGRATE" />

        <service
            android:name=".updater.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".updater.UpdateInstallResultReceiver"
            android:exported="false" />
        </application>

</manifest>
